OPENROUTER_API_KEY=your_openrouter_api_key_here

# Comma-separated list of valid unlock codes for premium features
# Example: ["HOOK-A1B2-C3D4","HOOK-E5F6-G7H8"]
UNLOCK_CODES=["your-unlock-code-here"]

# Secret key used to sign authentication tokens
# Generate with: openssl rand -hex 32
UNLOCK_SECRET=your_random_secret_key_at_least_32_chars

# AES-256 encryption key for client-server request encryption
# Must be exactly 64 hex characters (32 bytes)
# Generate with: openssl rand -hex 32
REQUEST_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here
